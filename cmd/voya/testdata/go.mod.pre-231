require (
	golang.org/x/net v0.57.0
	golang.org/x/text v0.40.0 // indirect
)

// Intra-repo, for the GOWORK=off case `make tidy-check` runs — test/trailer's
// precedent, whose go.mod makes the argument: ADR 001 rejects `replace` for
// the sibling repos, and these modules ship in this repository at fixed
// relative paths, so the replaces always resolve. proto is a production
// requirement: the daemon serves the generated schemas. authn and client are
// required only by tests (cmd/voya's, test/acceptance and
// internal/registration's, respectively); the arrows the other way are
// forbidden and enforced by authn/deps_test.go and client/deps_test.go.
replace (
	github.com/trendvidia/voya/authn => ./authn
	github.com/trendvidia/voya/client => ./client
	github.com/trendvidia/voya/proto => ./proto
)
